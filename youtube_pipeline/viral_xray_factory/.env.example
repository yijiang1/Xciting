# Required. Used for concept/script generation, TTS fallback, Whisper word
# timestamps, Sora footage, and thumbnails.
OPENAI_API_KEY=

# Model used by npm run concepts for script writing.
LLM_MODEL=gpt-5.1
# Model used by npm run thumbnails.
OPENAI_IMAGE_MODEL=gpt-image-1

# Hard per-concept cap for footage generation; generate:visuals refuses to
# spend past this estimate unless --footage-ok is passed.
MAX_VIDEO_BUDGET_USD=6

# --- Optional SOTA providers -------------------------------------------------

# ElevenLabs: best-in-class TTS (eleven_v3), music beds, and Eleven Music
# sung songs (required for any concept with a "song" field -- see README
# "Sung songs").
ELEVENLABS_API_KEY=
# elevenlabs | openai. Defaults to elevenlabs when the key above is set.
TTS_PROVIDER=
ELEVENLABS_MODEL_ID=eleven_v3
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
# JSON map of speaker/concept-id -> ElevenLabs voice id, to override casting.
ELEVENLABS_VOICE_MAP=

# Google Veo 3.1 via the Gemini API (alternative footage provider).
GEMINI_API_KEY=
# sora | veo. Defaults to veo when GEMINI_API_KEY is set, else sora.
VIDEO_PROVIDER=
SORA_MODEL=sora-2
VEO_MODEL=veo-3.1-fast-generate-preview
VEO_RESOLUTION=1080p

# OpenAI TTS model when TTS_PROVIDER=openai.
OPENAI_TTS_MODEL=gpt-4o-mini-tts
# Set to 0 to skip Whisper word timestamps (disables karaoke captions).
CAPTION_WORDS=1
# Length of generated music beds in milliseconds.
MUSIC_LENGTH_MS=60000

# --- YouTube upload ----------------------------------------------------------
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_PRIVACY_STATUS=private
YOUTUBE_MADE_FOR_KIDS=false
